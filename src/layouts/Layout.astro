---
import '../css/main.css';

interface Props {
	title?: string;
}

const { title = 'SABRINA NO REITA' } = Astro.props;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content="お絵かきと会話を楽しむための掲示板一覧です。" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<div class="site-shell">
			<header class="site-header">
				<a class="site-name" href="/" aria-label="SABRINA NO REITA ホーム">SNR</a>
				<p>お絵かき掲示板</p>
			</header>
			<slot />
			<footer>
				<p>© {new Date().getFullYear()} SABRINA NO REITA</p>
			</footer>
		</div>
	</body>
</html>
