---
import '../css/main.css';
import { counters } from '../data/counters';

interface Props {
  title?: string;
}

const { title = 'SABRINA NO REITA' } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="お絵かき掲示板「noReita」の開発とかサポートとか交流とかやってます。" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="twitter:card" content="summary">
    <meta name="twitter:site" content="@rokuro_sakots">
    <meta property="og:url" content="https://oekakibbs.moe/">
    <meta property="og:title" content="SABRINA NO REITA - お絵かき掲示板サイト">
    <meta property="og:description" content="お絵かき掲示板「noReita」の開発とかサポートとか交流とかやってます。">
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="site-name" href="/" aria-label="SABRINA NO REITA ホーム">
          <img src="https://oekakibbs.moe/img/reita_random.php" alt="SABRINA NO REITA" />
        </a>
      </header>
      <slot />
      <footer>
        <p>© {new Date().getFullYear()} SABRINA NO REITA</p>
        <div class="counter-list" aria-label="アクセスカウンター">
          {counters.map((counter) => (
            <span class="counter-item">
              <span class="counter-label">{counter.label}</span>
              <span class="counter-frame">
                <img class="counter-image" src={counter.image} alt={counter.alt} />
              </span>
            </span>
          ))}
        </div>
      </footer>
    </div>
  </body>
</html>
