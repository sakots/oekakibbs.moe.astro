---
import Layout from '../layouts/Layout.astro';
import { boards } from '../data/boards';
import { links } from '../data/links';
import { works } from '../data/works';
import { Icon } from 'astro-icon/components';

---

<Layout title="SABRINA NO REITA | お絵かき掲示板">
  <main>
    <section class="hero" aria-labelledby="site-title">
      <p class="eyebrow">さこつ、お仕事募集中。</p>
      <h1 id="site-title">SABRINA NO REITA</h1>
      <p class="lead">
        お絵かき掲示板「noReita」の開発してます。
        noReitaの最新バージョン→
        <a href="https://github.com/sakots/noReita/releases/latest" target="_blank" rel="noopener noreferrer"><img src="https://img.shields.io/github/v/release/sakots/noReita" alt="noReitaの最新バージョン" /></a>
      </p>
      <nav class="jump-links" aria-label="ページ内リンク">
        <a href="#boards">掲示板一覧</a>
        <a href="#works">作ったもの</a>
        <a href="#link">リンク集（令和最新版）</a>
        <a href="#about">このサイトとかについて</a>
        <a href="#contact">お問い合わせ</a>
        <a href="#about">ABOUT</a>
      </nav>
    </section>

    <section id="boards" class="boards" aria-labelledby="boards-title">
      <div class="section-heading">
        <p class="eyebrow">BOARDS</p>
        <h2 id="boards-title">掲示板ズ</h2>
      </div>

      <div class="board-grid">
        {boards.map((board) => (
          <article class="board-card">
            <a class="board-banner" href={board.href}>
              <img src={board.banner} alt={`${board.name} のバナー`} loading="lazy" decoding="async" />
            </a>
            <h3>{board.name}</h3>
            <p>{board.description}</p>
            <a class="board-link" href={board.href}>
              掲示板を開く <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section id="works" class="works" aria-labelledby="works-title">
      <div class="section-heading">
        <p class="eyebrow">WORKS</p>
        <h2 id="works-title">作ったもの</h2>
      </div>
      <ul class="works-list">
        {works.map((work) => (
          <li class="work-card">
            <h3><a href={work.url} target="_blank" rel="noopener noreferrer">{work.name}</a></h3>
            <p>{work.description}</p>
            <a class="work-link" href={work.url} target="_blank" rel="noopener noreferrer">詳しく見る <span aria-hidden="true">→</span></a>
          </li>
        ))}
      </ul>
    </section>

    <section id="link" class="links" aria-labelledby="link-title">
      <div class="section-heading">
        <p class="eyebrow">LINK</p>
        <h2 id="link-title">リンク集（令和最新版）</h2>
      </div>
      {
        links.length > 0 ? (
          <div class="link-list">
            {links.map((link) => (
              <article class="link-card">
                <a class="banner-link" href={link.url} target="_blank" rel="noopener noreferrer">
                  <img src={link.banner} alt={`${link.admin}さんのサイト`} loading="lazy" decoding="async" />
                </a>
                <div class="link-details">
                  <p class="link-admin">管理者：{link.admin}</p>
                  <p>{link.description}</p>
                  <a href={link.url} target="_blank" rel="noopener noreferrer">サイトを開く <span aria-hidden="true">→</span></a>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <p class="empty-links">リンクは準備中です。</p>
        )
      }
      <div class="link-note">
        <p>
          リンク集は随時更新されます。令和の今こそ相互リンク希望の方は掲示板にてご連絡ください。
        </p>
        <p>バナーは以下を貼り付けてください。直リンクだとたのしいね！</p>
        <pre class="banner-code">
<code>
  &lt;a href=&quot;https://oekakibbs.moe/&quot; target=&quot;_blank&quot; rel=&quot;noopener noreferrer&quot;&gt;
    &lt;img src=&quot;https://oekakibbs.moe/img/reita_random.php&quot; alt=&quot;SABRINA NO REITA&quot; /&gt;
  &lt;/a&gt;
</code>
        </pre>
      </div>
    </section>

    <section id="contact" class="contact" aria-labelledby="contact-title">
      <div class="section-heading">
        <p class="eyebrow">CONTACT</p>
        <h2 id="contact-title">お問い合わせ</h2>
      </div>
      <p>ご意見・ご要望・不具合報告などは掲示板にお願いします。</p>
    </section>

    <section id="about" class="about" aria-labelledby="about-title">
      <div class="section-heading">
        <p class="eyebrow">ABOUT</p>
        <h2 id="about-title">さこつだよー</h2>
      </div>
      <p class="social-links">
        <a href="https://www.nicovideo.jp/user/56971512" target="_blank" rel="noopener noreferrer">
          <Icon name="streamline-logos:niconico-logo-2" title="ニコニコ" />
        </a>
        <a href="https://manga.nicovideo.jp/search?q=%E3%82%B5%E9%AA%A8" target="_blank" rel="noopener noreferrer">
          <Icon name="arcticons:niconico-manga" title="ニコニコ漫画" />
        </a>
        <a href="https://twitter.com/@rokuro_sakots" target="_blank" rel="noopener noreferrer">
          <Icon name="arcticons:x-twitter" title="Twitter" />
        </a>
        <a href="https://misskey.io/@352696" target="_blank" rel="noopener noreferrer">
          <Icon name="simple-icons:misskey" title="misskey.io" />
        </a>
        <a href="https://www.pixiv.net/users/12645" target="_blank" rel="noopener noreferrer">
          <Icon name="arcticons:pixiv" title="Pixiv" />
        </a>
        <a href="https://github.com/sakots" target="_blank" rel="noopener noreferrer">
          <Icon name="simple-icons:github" title="Github" />
        </a>
      </p>
    </section>
  </main>
</Layout>
